<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal FileProvider paths (R5): only the controlled share cache is
     exposed; arbitrary internal directories are never readable. -->
<paths>
    <cache-path
        name="shared_images"
        path="shared_images/" />
    <!-- Reverse-image WebView upload: the armed input file is handed to the
         engine page's file chooser through this provider. -->
    <cache-path
        name="reverse_image_inputs"
        path="reverse_image_inputs/" />
    <files-path
        name="updates"
        path="updates/" />
</paths>
